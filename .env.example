# GEMINI_API_KEY: Required for Gemini AI API copilot and strategic generation.
# Obtain your API key from Google AI developer portal (https://ai.google.dev/).
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The base URL where this application is hosted.
# Used for self-referential links, callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# PORT: Server port (Defaults to 3000 in dev, 4000 for SSR production)
PORT=3000
